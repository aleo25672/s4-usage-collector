# SAP S/4 connection

# mock (default demo) | http (SICF JSON) | rfc (node-rfc stub)
SAP_PROVIDER=mock

SAP_SYSTEM_ID=S4H
SAP_INSTANCE=TOTAL
SAP_CLIENT=100

# --- HTTP mode (ICF handler ZCL_ZEVO_ST03_HTTP) ---
# SAP_PROVIDER=http
# SAP_HTTP_BASE_URL=http://10.0.0.189:50000/sap/bc/zevo_st03/workload
# SAP_USER=ARIA
# SAP_PASSWD=...

# --- RFC mode (requires NWRFC + node-rfc wiring) ---
# SAP_PROVIDER=rfc
# SAP_ASHOST=
# SAP_SYSNR=00
# SAP_USER=
# SAP_PASSWD=
